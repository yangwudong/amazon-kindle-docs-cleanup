<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kindle.pdocs-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- 改成你的 cleanup.py 绝对路径 -->
        <string>/Users/YOUR_USER/amazon-kindle-docs-cleanup/cleanup.py</string>
        <string>--apply</string>
    </array>

    <!-- 每天 09:30 执行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 改成你想放日志的路径 -->
    <key>StandardOutPath</key>
    <string>/tmp/kindle-cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kindle-cleanup.log</string>

    <key>WorkingDirectory</key>
    <!-- 改成你的脚本目录 -->
    <string>/Users/YOUR_USER/amazon-kindle-docs-cleanup</string>
</dict>
</plist>
